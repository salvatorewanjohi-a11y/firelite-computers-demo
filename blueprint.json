{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "login": false,
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "woocommerce"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/salvatorewanjohi-a11y/firelite-computers-demo/main/firelite.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "unzip",
      "zipFile": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/salvatorewanjohi-a11y/firelite-computers-demo/main/images.zip"
      },
      "extractToPath": "/wordpress"
    },
    {
      "step": "mkdir",
      "path": "/wordpress/flc-src"
    },
    {
      "step": "writeFile",
      "path": "/wordpress/flc-src/setup.php",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/salvatorewanjohi-a11y/firelite-computers-demo/main/setup.php"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/flc-src/products.json",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/salvatorewanjohi-a11y/firelite-computers-demo/main/products.json"
      }
    },
    {
      "step": "mkdir",
      "path": "/wordpress/wp-content/mu-plugins"
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/mu-plugins/flc-storefront.php",
      "data": "<?php\n// Shop demo link: show the store as a customer sees it.\nadd_filter( 'show_admin_bar', '__return_false' );\n"
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/flc-src/setup.php';"
    }
  ]
}
